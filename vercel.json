{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/supabase/save.js": {
      "maxDuration": 30
    },
    "api/supabase/data.js": {
      "maxDuration": 15
    },
    "api/supabase/delete-sheet.js": {
      "maxDuration": 15
    },
    "api/supabase/upload-statement.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
